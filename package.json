{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --require ./scripts/local-hidden-children.cjs --test tests/*.test.mjs",
    "eval:chat": "node scripts/evaluate-chat.mjs",
    "dev": "node --require ./scripts/local-hidden-children.cjs ./node_modules/vinext/dist/cli.js dev",
    "build": "node --require ./scripts/local-hidden-children.cjs ./node_modules/vinext/dist/cli.js build",
    "start": "node --require ./scripts/local-hidden-children.cjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "rag:init": "node scripts/rag/cli.mjs init",
    "rag:seed": "node scripts/rag/cli.mjs seed",
    "rag:serve": "node scripts/rag/cli.mjs serve",
    "rag:eval": "node scripts/rag/evaluate.mjs",
    "flowise:start": "node scripts/flowise/local-runtime.mjs",
    "flowise:bootstrap": "node scripts/flowise/bootstrap.mjs",
    "flowise:check": "node scripts/flowise/check-runtime.mjs",
    "configure:local-services": "node scripts/configure-local-services.mjs",
    "eval:flowise-rag": "node scripts/evaluate-flowise-rag.mjs",
    "flowise:prepare-model": "node scripts/flowise/prepare-model.mjs",
    "local:services": "node scripts/start-local-services.mjs",
    "local:start": "node scripts/start-local-stack.mjs",
    "eval:jeju-rag": "node scripts/evaluate-jeju-rag.mjs",
    "eval:rag-itinerary": "node scripts/evaluate-rag-itinerary.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
