 .tg-group-utilities>button:first-child>svg:last-child { margin-left:auto; }
 .tg-group-utilities>button { min-width:44px; white-space:nowrap; }
 .tg-my-group-list { border-top:1px solid var(--line); }
+.tg-my-group-filters { display:flex; flex-wrap:wrap; gap:8px; min-width:0; }
+.tg .tg-my-group-filters>button { flex:0 0 auto; gap:6px; min-height:44px; padding:10px; white-space:nowrap; background:transparent; font-weight:400; }
+.tg .tg-my-group-filters>button[aria-pressed=true] { color:white; background:var(--ink); border-color:var(--ink); font-weight:600; }
+.tg-my-group-filters>button>span { font-size:12px; line-height:16px; font-variant-numeric:tabular-nums; }
+.tg-my-group-sort { display:flex; align-items:center; justify-content:space-between; gap:8px; min-width:0; }
+.tg-my-group-sort>span { min-width:0; font-size:14px; line-height:20px; }
+.tg-my-group-sort>label { display:flex; align-items:center; gap:8px; min-width:0; }
+.tg-my-group-sort>label>span { color:var(--muted); font-size:12px; line-height:16px; }
+.tg .tg-my-group-sort select { width:auto; min-width:0; min-height:44px; max-width:160px; padding:8px 28px 8px 10px; font-size:16px; line-height:24px; border:1px solid var(--line); border-radius:12px; background-color:transparent; color:var(--ink); }
+.tg-my-group-sections { display:grid; gap:20px; min-width:0; }
+.tg-my-group-sections>section { min-width:0; }
+.tg .tg-my-group-sections h2 { display:flex; gap:8px; align-items:center; margin-bottom:10px; font-size:16px; line-height:22px; font-weight:600; }
+.tg-my-group-sections h2>span { color:var(--muted); font-size:12px; line-height:16px; font-weight:400; }
+.tg .tg-my-group-archives>summary { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:44px; list-style:none; color:var(--muted); font-size:14px; line-height:20px; }
+.tg-my-group-archives>summary::-webkit-details-marker { display:none; }
+.tg-my-group-archives>summary>svg { flex-shrink:0; }
+.tg-my-group-archives[open]>summary>svg { transform:rotate(180deg); }
 .tg .tg-my-group-row { display:flex; width:100%; gap:12px; padding:14px 0; border:0; border-bottom:1px solid var(--line); border-radius:0; background:transparent; text-align:left; font-weight:400; justify-content:flex-start; }
 .tg-my-group-photo { display:grid; place-items:center; flex:0 0 64px; width:64px; height:64px; border-radius:12px; background:var(--line); color:var(--muted); overflow:hidden; }
 .tg-my-group-photo img { display:block; width:100%; height:100%; object-fit:cover; }
