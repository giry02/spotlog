 .tg-room-stream .tg-message-tools button { min-width:44px; padding:8px; }
 .tg-room-stream .tg-message-tools { gap:8px; }
 .tg-room-stream .tg-message-tools button { width:44px; height:44px; border:0; background:transparent; color:#73756d; }
 .tg-message-menu { display:flex; flex-wrap:wrap; gap:8px; padding:8px 0; }
 .tg-message-menu button { min-height:44px; font-size:14px; }
-.tg-unread-divider { display:flex; align-items:center; gap:12px; margin:6px 0 20px; color:#7a6550; font-size:12px; }
+.tg-unread-divider { display:flex; align-items:center; gap:12px; margin:4px 0 12px; color:#7a6550; font-size:12px; line-height:16px; }
 .tg-unread-divider::before,.tg-unread-divider::after { content:''; height:1px; flex:1; background:#e5dbce; }
 .tg-room-stream .tg-quoted-message { display:grid; width:100%; min-height:44px; gap:4px; padding:10px; margin:0 0 8px; border:0; border-left:3px solid #b6cbbf; border-radius:6px; background:#00000006; text-align:left; }
-.tg-quoted-message strong { font-size:12px; color:#47695a; }
-.tg-quoted-message span { font-size:14px; line-height:1.5; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; overflow-wrap:anywhere; }
+.tg-quoted-message strong { font-size:12px; line-height:16px; color:#47695a; }
+.tg-quoted-message span { font-size:14px; line-height:20px; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; overflow-wrap:anywhere; }
 .tg-message-reactions,.tg-reaction-picker { display:flex; flex-wrap:wrap; gap:8px; margin:8px 0; }
 .tg-message-reactions button,.tg-reaction-picker button { min-width:44px; min-height:44px; padding:8px 10px; font-size:16px; }
 .tg-message-reactions button[aria-pressed=true] { border-color:#6a8d7b; background:#eaf3ed; }
-.tg .tg-chat-latest { position:sticky; bottom:calc(96px + env(safe-area-inset-bottom)); z-index:7; display:flex; align-items:center; justify-content:center; margin:0 18px 12px auto; width:44px; height:44px; padding:10px; border-radius:50%; background:#fff; box-shadow:0 3px 12px #00000014; }
+.tg .tg-chat-latest { position:sticky; bottom:calc(96px + env(safe-area-inset-bottom)); z-index:7; display:flex; align-items:center; justify-content:center; margin:0 16px 12px auto; width:44px; height:44px; padding:10px; border-radius:50%; background:#fff; box-shadow:0 3px 12px #00000014; }
 .tg-reply-preview { display:flex; align-items:center; gap:8px; padding:12px 16px; border-bottom:1px solid var(--line); background:#f7f7f2; }
 .tg-reply-preview > div { flex:1; min-width:0; }
 .tg-reply-preview strong { font-size:12px; color:#47695a; }
