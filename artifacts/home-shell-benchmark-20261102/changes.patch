   const prepScreen = () => <div className="tg-stack"><div className="tg-section"><h2>준비물·담당 할 일</h2>{editor && <button onClick={() => open('task')}><Plus size={16} />추가</button>}</div>{state.tasks.filter(item => item.activityId === activity?.id).map(task => <div key={task.id}><label className={`tg-checkrow ${task.completed ? 'done' : ''}`}><input type="checkbox" checked={task.completed} disabled={group?.archived || (!editor && task.assigneeId !== uid)} onChange={event => mutate(draft => { draft.tasks.find(item => item.id === task.id)!.completed = event.target.checked; })} /><div><p>{task.title}</p><small>{task.assigneeId ? memberName(state, task.assigneeId) : '공동 준비'}{task.dueDate ? ` · ${dateLabel(task.dueDate)}까지` : ''}</small></div></label>{task.sourceMessageIds?.[0] && <button className="tg-text-button" onClick={() => openTaskSource(task.sourceMessageIds![0])}>관련 대화 보기 <ArrowRight size={14} /></button>}</div>)}{!state.tasks.some(item => item.activityId === activity?.id) && <div className="tg-summary"><p>챙길 물건이나 확인할 일을 등록해요. 대화 정리 예시에서 항목을 골라 담아볼 수도 있어요.</p></div>}<div className="tg-section"><h2>함께 고르기</h2>{editor && <button onClick={() => open('poll')}><Plus size={16} />투표</button>}</div>{state.polls.filter(item => item.activityId === activity?.id).map(poll => <div className="tg-card tg-stack" key={poll.id}><h3>{poll.question}</h3>{poll.options.map(option => <button key={option.id} className={option.voterIds.includes(uid) ? 'tg-soft' : ''} disabled={poll.closed || group?.archived} onClick={() => mutate(draft => { const target = draft.polls.find(item => item.id === poll.id)!; target.options.forEach(value => { value.voterIds = value.voterIds.filter(id => id !== uid); }); target.options.find(value => value.id === option.id)!.voterIds.push(uid); })}>{option.label} · {option.voterIds.length}명 {poll.confirmedOptionId === option.id && <Check size={16} />}</button>)}{editor && !poll.closed && <select aria-label="투표 결과 확정" value="" onChange={event => { const id = event.target.value; if (id) mutate(draft => { const target = draft.polls.find(item => item.id === poll.id)!; target.confirmedOptionId = id; target.closed = true; }, '선택을 확정했어요. 예약·일정은 자동 변경되지 않아요.'); }}><option value="">결과를 확인하고 선택 확정</option>{poll.options.map(option => <option key={option.id} value={option.id}>{option.label}</option>)}</select>}{poll.closed && <small>확정됨 · 예약과 일정 변경은 별도 확인</small>}</div>)}</div>;
