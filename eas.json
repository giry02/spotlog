{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SPOTLOG_WEB_URL": "https://giry02.github.io/spotlog/"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SPOTLOG_WEB_URL": "https://giry02.github.io/spotlog/"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
