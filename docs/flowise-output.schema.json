{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moa Flowise structured reply v1",
  "description": "모델이 생성할 수 있는 설명과 기능 행동의 전체 스키마. 후보 ID, 현재 DAY와 예약 보호는 서버가 별도로 검증한다. reset/undo/resume/message는 모델 행동에서 제외한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message",
    "actions"
  ],
  "properties": {
    "evidenceIds": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
      },
      "description": "Only evidence IDs from server context.retrieval, when used."
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S",
      "allOf": [
        {
          "not": {
            "pattern": "<\\/?[a-zA-Z][^>]*>"
          }
        },
        {
          "not": {
            "pattern": "[Hh][Tt][Tt][Pp][Ss]?://|[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]:|[Dd][Aa][Tt][Aa]:"
          }
        }
      ]
    },
    "actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "place"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "bookmark"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "saved": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "food"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "stay"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "stage"
            ],
            "properties": {
              "type": {
                "const": "show"
              },
              "stage": {
                "$ref": "#/$defs/stage"
              },
              "kind": {
                "enum": [
                  "식당",
                  "카페",
                  "상점"
                ]
              },
              "day": {
                "$ref": "#/$defs/day"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "region"
            ],
            "properties": {
              "type": {
                "const": "region"
              },
              "region": {
                "enum": [
                  "제주",
                  "서울",
                  "부산",
                  "경주",
                  "강릉"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "walk"
              },
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "cuisine"
              },
              "value": {
                "enum": [
                  "전체",
                  "한식",
                  "양식"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "stay-budget"
              },
              "value": {
                "$ref": "#/$defs/money"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "build"
              },
              "savedOnly": {
                "type": "boolean"
              },
              "visits": {
                "type": "array",
                "minItems": 1,
                "maxItems": 14,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "day",
                    "placeId"
                  ],
                  "properties": {
                    "day": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 7
                    },
                    "placeId": {
                      "$ref": "#/$defs/id"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "day"
            ],
            "properties": {
              "type": {
                "const": "day"
              },
              "day": {
                "$ref": "#/$defs/day"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "add-selected"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "edit"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "remove"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "direction"
            ],
            "properties": {
              "type": {
                "const": "move"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "direction": {
                "type": "integer",
                "enum": [
                  -1,
                  1
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "directions"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "placeId": {
                "$ref": "#/$defs/id"
              },
              "businessId": {
                "$ref": "#/$defs/id"
              }
            },
            "allOf": [
              {
                "not": {
                  "required": [
                    "id",
                    "placeId"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "id",
                    "businessId"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "placeId",
                    "businessId"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "status"
            ],
            "properties": {
              "type": {
                "const": "progress"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "status": {
                "enum": [
                  "done",
                  "skipped",
                  "pending"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "save"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "open"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "compare"
              },
              "ids": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "budget"
              },
              "people": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "rooms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "check"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "detail"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "library"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "help"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "history"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "day"
            ],
            "properties": {
              "type": {
                "const": "transfer"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "day": {
                "$ref": "#/$defs/day"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "add-entity"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "day": {
                "$ref": "#/$defs/day"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "select-entity"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "configure"
              },
              "days": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "theme": {
                "enum": [
                  "all",
                  "sea",
                  "green"
                ]
              },
              "foodBudget": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/money"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "booked": {
                "type": "boolean"
              },
              "meals": {
                "type": "boolean"
              },
              "cafes": {
                "type": "boolean"
              },
              "lodging": {
                "type": "boolean"
              },
              "businessMode": {
                "enum": [
                  "registered",
                  "demo"
                ]
              },
              "nearbyExpanded": {
                "type": "boolean"
              }
            },
            "minProperties": 2
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "collect-entity"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "uncollect-entity"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "copy-community"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "community-filter"
              },
              "region": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "제주",
                  "서울",
                  "부산",
                  "경주",
                  "강릉",
                  null
                ]
              },
              "theme": {
                "type": "string",
                "enum": [
                  "all",
                  "sea",
                  "green"
                ]
              },
              "query": {
                "type": "string",
                "maxLength": 100
              },
              "contentType": {
                "type": "string",
                "enum": [
                  "all",
                  "traveler",
                  "ai"
                ]
              },
              "days": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 7
              },
              "authorId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "minProperties": 2
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "trip-meta"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "startDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "minProperties": 2
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "visit-details"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "note": {
                "type": "string",
                "maxLength": 1000
              },
              "time": {
                "type": "string",
                "pattern": "^(?:|(?:[01][0-9]|2[0-3]):[0-5][0-9])$"
              },
              "durationMinutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440
              }
            },
            "minProperties": 3
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "stayId",
              "startDay",
              "nights"
            ],
            "properties": {
              "type": {
                "const": "stay-placement"
              },
              "stayId": {
                "$ref": "#/$defs/id"
              },
              "startDay": {
                "type": "integer",
                "minimum": 1,
                "maximum": 29
              },
              "nights": {
                "type": "integer",
                "minimum": 1,
                "maximum": 29
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "day-add"
              },
              "afterDay": {
                "$ref": "#/$defs/day"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "day"
            ],
            "properties": {
              "type": {
                "const": "day-copy"
              },
              "day": {
                "$ref": "#/$defs/day"
              },
              "toDay": {
                "$ref": "#/$defs/day"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "day"
            ],
            "properties": {
              "type": {
                "const": "day-delete"
              },
              "day": {
                "$ref": "#/$defs/day"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "visit-copy"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "day": {
                "$ref": "#/$defs/day"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "ids"
            ],
            "properties": {
              "type": {
                "const": "candidate-propose"
              },
              "ids": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "day": {
                "$ref": "#/$defs/day"
              },
              "anchorId": {
                "$ref": "#/$defs/id"
              },
              "slot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "groupId",
              "id"
            ],
            "properties": {
              "type": {
                "const": "candidate-select"
              },
              "groupId": {
                "$ref": "#/$defs/id"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "candidate-apply"
              },
              "selections": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "groupId",
                    "id"
                  ],
                  "properties": {
                    "groupId": {
                      "$ref": "#/$defs/id"
                    },
                    "id": {
                      "$ref": "#/$defs/id"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "candidate-reject"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "trash-list"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "trash"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "restore"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "target"
            ],
            "properties": {
              "type": {
                "const": "open_spotlog"
              },
              "target": {
                "type": "string",
                "enum": [
                  "discover",
                  "community",
                  "saved",
                  "trips",
                  "journal",
                  "photos",
                  "videos",
                  "profile",
                  "account",
                  "privacy",
                  "report",
                  "share_source",
                  "notifications"
                ]
              },
              "entry": {
                "type": "string",
                "enum": [
                  "journal-text",
                  "journal-photos",
                  "journal-draft",
                  "journal-preview",
                  "journal-visibility",
                  "place-comment",
                  "personal-place",
                  "account-email",
                  "account-reset",
                  "account-logout",
                  "account-delete",
                  "place-reaction",
                  "journey-comment",
                  "journey-cheer",
                  "profile-summary",
                  "profile-activity"
                ]
              },
              "journeyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[\\p{L}\\p{N}_:-]+$"
              },
              "day": {
                "$ref": "#/$defs/day"
              },
              "placeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[\\p{L}\\p{N}_:-]+$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "entry": {
                      "const": "journal-text"
                    }
                  },
                  "required": [
                    "entry"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "const": "journal"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "entry": {
                      "const": "journal-photos"
                    }
                  },
                  "required": [
                    "entry"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "const": "journal"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "entry": {
                      "const": "journal-draft"
                    }
                  },
                  "required": [
                    "entry"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "const": "journal"
                    }
                  }
