# Public browser Maps client ID; register your actual site origin in Maps.
VITE_NAVER_MAP_CLIENT_ID=
# Same-origin Spotlog backend paths. Never put provider secrets here.
VITE_PLACE_SEARCH_ENDPOINT=
VITE_ROUTE_ENDPOINT=
# Public AI service URL. The server owns model credentials and room authorization.
# Empty means no AI request is sent; original-message collection remains available.
VITE_CHAT_AI_ENDPOINT=
# Optional same-origin model service for place search, group copy and trip drafts.
# Empty: only registered-catalog / local drafts. Example (configured server): /api/planning-ai
VITE_PLANNING_AI_ENDPOINT=
# Account service exposes shared session, email signup/verification/login/reset,
# approved policies and additional Google/Apple OAuth.
# Provider secrets, token verification and consent audit timestamps stay on the server.
# With this unset, DEV localhost provides the explicitly labelled review login.
# Setting an endpoint always selects real authentication, even in review mode.
VITE_ACCOUNT_ENDPOINT=
# Static preview only: 1 enables the clearly labelled review email account when
# VITE_ACCOUNT_ENDPOINT is empty. This never connects signup, mail or social auth.
# Leave empty for a normal production build; an endpoint always takes precedence.
VITE_ACCOUNT_REVIEW_MODE=

# Development only: optional backend target for /api. Never exposed to browsers.
SPOTLOG_DEV_API_TARGET=
# Development only: routes planning and chat AI to the loopback gateway before the general /api proxy.
SPOTLOG_PLANNING_AI_DEV_TARGET=

# Local gateway only. Enable explicit scoped chat summary endpoint (/api/chat-ai).
# This dev gateway does not implement production session/membership authorization.
SPOTLOG_LOCAL_CHAT_AI=
