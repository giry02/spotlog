# Public browser Maps client ID; register your actual site origin in Maps.
VITE_NAVER_MAP_CLIENT_ID=
# Same-origin Spotlog backend paths. Never put provider secrets here.
VITE_PLACE_SEARCH_ENDPOINT=
VITE_ROUTE_ENDPOINT=
# Account service exposes shared session, email signup/verification/login/reset,
# approved policies and additional Google/Apple OAuth.
# Provider secrets, token verification and consent audit timestamps stay on the server.
# With this unset, DEV localhost provides the explicitly labeled review login only.
# Setting an endpoint selects real authentication; production never includes demo credentials.
VITE_ACCOUNT_ENDPOINT=

# Development only: optional backend target for /api. Never exposed to browsers.
SPOTLOG_DEV_API_TARGET=
