# Optional server-only Flowise bridge. Leave empty for the interactive demo.
# Never expose these values through NEXT_PUBLIC_* or client-side settings.
FLOWISE_BASE_URL=
FLOWISE_CHATFLOW_ID=
FLOWISE_PLANNER_CHATFLOW_ID=
FLOWISE_API_KEY=
FLOWISE_TIMEOUT_MS=20000
CHAT_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=45000
# Optional fast full-itinerary fallback; ordinary Flowise chat stays unchanged.
# Set only to an already installed, verified local model, e.g. qwen3:4b-instruct-2507-q4_K_M.
LOCAL_ITINERARY_MODEL=
# Separate cold-load budget for the optional planner (1000..90000 ms).
LOCAL_ITINERARY_TIMEOUT_MS=75000
RAG_ENABLED=false
RAG_BASE_URL=http://127.0.0.1:8765
RAG_API_KEY=
RAG_TIMEOUT_MS=15000
# Automatic escalation can use a larger local Ollama model without an API key.
# Local example: provider=ollama, base=http://127.0.0.1:11434, name=qwen3:14b.
# Gemini is free-only: every generation must verify this key's project has billing disabled.
# Missing/expired verification credentials, enabled billing, quota, or outages use local fallback.
# A valid key, a free-capable model, local usage limits and 429 handling alone DO NOT prove no charge.
# Compatible remote APIs are blocked by the free-only runtime policy.
# Run node scripts/configure-large-model.mjs --provider=ollama --model=qwen3:14b
# after the local model download to verify availability and save .dev.vars.
# Credentials must never use NEXT_PUBLIC_* or be sent in chat.
LARGE_MODEL_PROVIDER=
LARGE_MODEL_BASE_URL=
LARGE_MODEL_NAME=
LARGE_MODEL_API_KEY=
LARGE_MODEL_TIMEOUT_MS=180000
# Independent loopback fallback remains available when Gemini is selected.
LOCAL_LARGE_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_LARGE_MODEL_NAME=qwen3:14b
LOCAL_LARGE_MODEL_TIMEOUT_MS=180000
# Optional short-lived Google OAuth token: API Keys lookupKey + Cloud Billing getBillingInfo.
# This is server-only, not the Gemini API key. A direct token takes precedence over refresh credentials.
GEMINI_BILLING_VERIFICATION_TOKEN=
# Optional persistent Google authorized_user credentials, JSON containing exactly:
# type=authorized_user, client_id, client_secret, refresh_token. Saved by the local auth helper.
# Windows setup with the project-local official Google Cloud SDK installed:
# node scripts/authenticate-gemini-free.mjs --login
# Official SDK consent includes Cloud management scope; runtime calls only the fixed read APIs.
# The helper verifies billing is disabled before saving; it never generates an answer or links billing.
# JSON must use outer single quotes in .dev.vars, which the helper writes correctly.
# Only access tokens are cached in memory; key/project identity and billing are checked every call.
# Missing, expired or revoked authorization keeps Gemini generation disabled and uses local fallback.
# Never expose these credentials through NEXT_PUBLIC_* or send them in chat.
GEMINI_BILLING_VERIFICATION_CREDENTIALS=
# Optional Google API consumer/quota project ID or number for verification GET requests.
# It is not a billing-disable assertion and does not change which key's project is verified.
GEMINI_BILLING_VERIFICATION_PROJECT=
# Conservative app limits, adjustable only downward; provider free quotas also apply.
# These process-local traffic limits are not Google's billing or quota enforcement.
GEMINI_FREE_MAX_REQUESTS_PER_MINUTE=5
GEMINI_FREE_MAX_REQUESTS_PER_DAY=20
